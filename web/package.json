{
  "name": "stt-vault-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "pnpm check",
    "format": "prettier --plugin=prettier-plugin-svelte --check src package.json pnpm-workspace.yaml svelte.config.js tsconfig.json vite.config.ts vitest.config.ts",
    "test": "svelte-kit sync && vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "marked": "^18.0.6"
  }
}
